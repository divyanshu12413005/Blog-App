<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".MyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/blogicon"
        android:label="@string/app_name"
        android:roundIcon="@drawable/blogicon"
        android:supportsRtl="true"
        android:theme="@style/Theme.BlogApp">
        <activity
            android:name=".AuthorProfileActivity"
            android:exported="false" />
        <activity
            android:name=".ImagePreviewActivity"
            android:exported="false" />
        <activity
            android:name=".ProfileActivity"
            android:exported="false" />
        <activity
            android:name=".MyArticlesActivity"
            android:exported="false" />
        <activity
            android:name=".SavedArticlesActivity"
            android:exported="false" />
        <activity
            android:name=".AddBlogActivity"
            android:exported="false" />
        <activity
            android:name=".EditArticleActivity"
            android:exported="false" />
        <activity
            android:name=".BlogDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ResetPasswordActivity"
            android:exported="false" />
        <activity
            android:name=".VerificationActivity"
            android:exported="false" />
        <activity
            android:name=".ForgotPasswordActivity"
            android:exported="false" />
        <activity
            android:name=".SignAndRegisterActivity"
            android:exported="false" />
        <activity
            android:name=".register.WelcomeActivity"
            android:exported="false" />
        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <meta-data
            android:name="preloaded_fonts"
            android:resource="@array/preloaded_fonts" />
    </application>

</manifest>